formulas:
  Untitled: ""
views:
  - type: table
    name: Table
    filters:
      and:
        - file.ext != "jpg"
        - file.ext != "png"
        - file.tags.contains("graph_export")
    order:
      - file.name
      - formula.Untitled
      - file.backlinks
      - file.tags
      - vc-id
    sort:
      - property: tags
        direction: ASC
    columnSize:
      file.backlinks: 147
      file.tags: 303
